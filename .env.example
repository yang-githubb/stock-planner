# Copy this file to backend/.env and fill in your values.
# The backend loads backend/.env when you run uvicorn from the backend/ folder.

# Finnhub API key (https://finnhub.io/)
FINNHUB_API_KEY=your_api_key_here

# Supabase PostgreSQL (recommended)
# Dashboard: Project Settings → Database → Connection string → URI
#
# Local dev (faster): Direct connection, port 5432
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
#
# Production / serverless (many short-lived workers): Transaction pooler, port 6543
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Optional: local SQLite for offline experiments only (not recommended for production)
# DATABASE_URL=sqlite+aiosqlite:///./stock_platform.db

# CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Trending stocks on dashboard (comma-separated)
# TRENDING_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,NVDA,TSLA

# If you get SSL certificate errors on Windows, add:
# DATABASE_SSL_VERIFY=false
