# Finnhub API key (get one at https://finnhub.io/)
FINNHUB_API_KEY=your_api_key_here

# Database URL (defaults to local SQLite if not set)
# DATABASE_URL=sqlite+aiosqlite:///./stock_platform.db

# CORS origins (comma-separated, defaults to localhost:5173)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Trending stocks shown on dashboard (comma-separated)
# TRENDING_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,NVDA,TSLA
